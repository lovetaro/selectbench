# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Environment / secrets
.env
.env.*

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Generated artifacts (per-user; not part of the shipped benchmark)
generated_samples/
logs/

# Results — default: ignore everything under here. Only results/README.md
# (layout + column schema) is tracked; per-run result CSVs are regenerated by
# the generate → evaluate → summarize flow. To add an exemplary CSV to the
# tracked set later, use `git add -f`.
results/

# RL baselines (REINVENT / ACEGEN) — not part of this release. Excluded
# wholesale so their run dirs, checkpoints, logs, and local configs (some with
# machine-specific paths) can never be committed.
baselines/reinvent/
baselines/acegen/
scripts/rl_baselines/

# Per-user SpecLig scratch: a local no-defaults-channel env copy (the workaround
# in baselines/speclig/README.md) and a per-PDB test config pointing at a local,
# non-shipped dataset. Kept on disk but out of the tracked set.
baselines/speclig/env_cuda117_nodefaults.yaml
baselines/speclig/test_mol_*.yaml

# Scratch / verification artifacts (per-user cluster runs; never shipped).
# Backstop so stray GPU-verification output can't be committed by accident.
_verify*
_stage/
*.sbatch
*.out
*.zip
outputs_gpu/
gen_results/
